# SolarAI Backend Environment Configuration

# Database Connection
# PostgreSQL (Production / Docker):
DATABASE_URL=postgresql://solarai_user:solarai_secure_password_2026@localhost:5432/solarai_db
# SQLite (Local Dev / Fallback):
# DATABASE_URL=sqlite:///./solarai.db

# API Security Secret Key
API_SECRET_KEY=solarai_super_secret_dev_key_change_in_production
REQUIRE_DEVICE_TOKEN=false

# Allowed CORS Origins (JSON array or comma-separated)
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://127.0.0.1:3000","http://127.0.0.1:3001"]

# Default Solar Panel Physical Calibration Parameters
DEFAULT_PANEL_AREA_M2=0.65
DEFAULT_RATED_POWER_W=100.0

# Device Heartbeat Thresholds (seconds)
DEVICE_ONLINE_THRESHOLD_SEC=60
DEVICE_STALE_THRESHOLD_SEC=180
