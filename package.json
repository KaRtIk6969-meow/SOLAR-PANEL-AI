{
  "name": "solar-panel-ai-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "SolarAI - Solar Panel Monitoring System with AI Efficiency Prediction",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix frontend run start",
    "lint": "npm --prefix frontend run lint",
    "backend:dev": "uvicorn app.main:app --app-dir backend --host 0.0.0.0 --port 8000 --reload",
    "backend:test": "pytest backend/tests -v",
    "backend:migrate": "alembic -c backend/alembic.ini upgrade head"
  }
}
